rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The app stores everything as documents inside one collection,
    // keyed by strings like "schools_registry", "students", "scores", etc.
    match /cte_solutions/{docId} {

      // Only requests carrying a valid Firebase Auth token (the app signs
      // every device in anonymously on load) may read or write.
      // This blocks random internet traffic / scanners hitting the
      // database directly with just the public apiKey.
      allow read, write: if request.auth != null;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
